rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function notBlocked(p) {
      return !exists(/databases/$(database)/documents/blocks/$(p[0] + '_' + p[1]))
          && !exists(/databases/$(database)/documents/blocks/$(p[1] + '_' + p[0]));
    }
    function conversationParticipants(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // ── players ──
    match /players/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── stores ──
    match /stores/{storeId} {
      // get: si el documento no existe (resource == null) se permite, para que
      // preguntar "¿tengo tienda?" no tire error. Si existe, solo la lee el
      // dueño o cualquiera si es pública.
      allow get: if isSignedIn()
                 && (resource == null
                     || resource.data.isPublic == true
                     || resource.data.ownerId == request.auth.uid);

      // list: las queries deben filtrar por isPublic == true o por ownerId
      // (todas las nuestras ya lo hacen)
      allow list: if isSignedIn()
                  && (resource.data.isPublic == true
                      || resource.data.ownerId == request.auth.uid);

      // el ID de la tienda tiene que ser el UID del dueño: una tienda por usuario
      allow create: if isSignedIn()
                    && storeId == request.auth.uid
                    && request.resource.data.ownerId == request.auth.uid;

      // el dueño no puede transferir la tienda cambiando ownerId
      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid;

      match /products/{productId} {
        // los productos de una tienda privada tampoco se ven
        allow read: if isSignedIn()
                    && (get(/databases/$(database)/documents/stores/$(storeId)).data.isPublic == true
                        || get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid);
        allow write: if isSignedIn()
                     && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
      }
    }

    // ── conversations ──
    match /conversations/{conversationId} {
      allow get: if isSignedIn()
                && (resource == null || request.auth.uid in resource.data.participants);

      allow list: if isSignedIn()
                  && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && notBlocked(request.resource.data.participants);

      // Marcar como leído (solo unreadBy) siempre se permite.
      // Cambiar el último mensaje exige que no haya bloqueo.
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadBy'])
                        || notBlocked(resource.data.participants));

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in conversationParticipants(conversationId);

        allow create: if isSignedIn()
                      && request.auth.uid in conversationParticipants(conversationId)
                      && notBlocked(conversationParticipants(conversationId))
                      && request.resource.data.senderId == request.auth.uid;
      }
    }

    match /blocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.blockerId == request.auth.uid
                    && request.resource.data.blockedId != request.auth.uid
                    && blockId == request.auth.uid + '_' + request.resource.data.blockedId;
      allow delete: if isSignedIn() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.reportedUserId != request.auth.uid
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.reason is string
                    && (!('details' in request.resource.data) || request.resource.data.details.size() <= 500)
                    && request.resource.data.keys().hasOnly(
                        ['reporterId', 'reportedUserId', 'targetType', 'storeId',
                          'conversationId', 'reason', 'details', 'status', 'createdAt']);
      allow read, update, delete: if false;
    }
  }
}