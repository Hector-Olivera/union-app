{
  "expo": {
    "name": "Emprenda ya",
    "slug": "union-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "emprendaya",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon3.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.emprendaya.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon3B.png",
        "backgroundColor": "#CB0B0B"
      },
      "package": "com.emprendaya.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Emprenda Ya usa la camara para realidad aumentada y escaneo QR.",
          "recordAudioAndroid": false
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/adaptive-icon3B.png",
          "resizeMode": "contain",
          "backgroundColor": "#CB0B0B"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "uneon-app",
          "project": "uneon-app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ee15cca1-19d8-422a-9313-4ab8df3392a8"
      }
    }
  }
}
